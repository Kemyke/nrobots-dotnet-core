<Project>
  <!-- Settings shared by every project in the repository. MSBuild imports this file automatically. -->

  <PropertyGroup Label="Identity">
    <Product>NRobotsCore</Product>
    <Authors>Steven Jones;Kemy</Authors>
    <Company>$(Authors)</Company>
    <Copyright>Copyright 2013</Copyright>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <VersionPrefix>2.0.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Compilation">
    <!-- The newest C# for every target; features that need runtime support still fail to compile on old targets. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- The .NET analyzers run for every target, not only .NET 5+, with every rule as a warning (and so, below,
         an error). "latest" on purpose: a newer SDK's new rules should fail the build until the code complies.
         Any exception is suppressed where it occurs, with a Justification saying why. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <!-- CA1510 suggests ArgumentNullException.ThrowIfNull, which netstandard2.0 and net462 don't have. -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
